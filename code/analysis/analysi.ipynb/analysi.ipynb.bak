   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from pathlib import Path\n",
    "\n",
    "# =========================\n",
    "# 入力\n",
    "# =========================\n",
    "XLSX = Path(\"..\") / \"results_10fold\" / \"SRDP_1\" / \"SRDP_1_rep03_Tn_25_10fold_conf_matrices.xlsx\"\n",
    "\n",
    "# =========================\n",
    "# 保存先\n",
    "# =========================\n",
    "try:\n",
    "    SCRIPT_DIR = Path(__file__).resolve().parent\n",
    "except NameError:\n",
    "    SCRIPT_DIR = Path.cwd()\n",
    "\n",
    "OUT_DIR = SCRIPT_DIR\n",
    "OUT_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "OUT_PDF = OUT_DIR / \"conf8cls_icann_bw.pdf\"\n",
    "\n",
    "plt.rcParams[\"svg.fonttype\"] = \"none\"\n",
    "plt.rcParams[\"pdf.fonttype\"] = 42\n",
    "plt.rcParams[\"font.size\"] = 8\n",
    "\n",
    "# =========================\n",
    "# 読み込み\n",
    "# =========================\n",
    "df = pd.read_excel(XLSX, sheet_name=\"conf_8cls\", header=None)\n",
    "\n",
    "raw_names = df.iloc[0, 1:].astype(str).tolist()\n",
    "cm = df.iloc[1:, 1:].to_numpy(dtype=float)\n",
    "\n",
    "# =========================\n",
    "# ラベル自動変換\n",
    "# =========================\n",
    "name_map = {\n",
    "    \"Al_board\": \"aluminum bd.\",\n",
    "    \"buta_omote\": \"outer pigskin\",\n",
    "    \"buta_ura\": \"back pigskin\",\n",
    "    \"cork\": \"cork\",\n",
    "    \"denim\": \"denim\",\n",
    "    \"rubber_board\": \"rubber bd.\",\n",
    "    \"washi\": \"Japanese paper\",\n",
    "    \"wood_board\": \"wood bd.\"\n",
    "}\n",
    "\n",
    "class_names = [name_map.get(x, x) for x in raw_names]\n",
    "\n",
    "# =========================\n",
    "# 行正規化\n",
    "# =========================\n",
    "row_sums = cm.sum(axis=1, keepdims=True)\n",
    "cm_norm = cm / np.where(row_sums == 0, 1, row_sums)\n",
    "\n",
    "# =========================\n",
    "# プロット\n",
    "# =========================\n",
    "fig, ax = plt.subplots(figsize=(4.8, 4.0), dpi=300)\n",
    "\n",
    "im = ax.imshow(cm_norm, cmap=\"Greys\", vmin=0.0, vmax=1.0)\n",
    "\n",
    "# 軸ラベルは消す\n",
    "ax.set_xlabel(\"\")\n",
    "ax.set_ylabel(\"\")\n",
    "\n",
    "# 目盛り位置\n",
    "ax.set_xticks(np.arange(len(class_names)))\n",
    "ax.set_yticks(np.arange(len(class_names)))\n",
    "\n",
    "# 上側にxラベル\n",
    "ax.tick_params(\n",
    "    top=True, bottom=False,\n",
    "    labeltop=True, labelbottom=False,\n",
    "    length=0, pad=2\n",
    ")\n",
    "\n",
    "ax.set_xticklabels(\n",
    "    class_names,\n",
    "    rotation=60,\n",
    "    ha=\"left\",\n",
    "    rotation_mode=\"anchor\",\n",
    "    fontsize=7\n",
    ")\n",
    "ax.set_yticklabels(class_names, fontsize=7)\n",
    "\n",
    "# セル内数値\n",
    "for i in range(cm_norm.shape[0]):\n",
    "    for j in range(cm_norm.shape[1]):\n",
    "        val = cm_norm[i, j]\n",
    "        ax.text(\n",
    "            j, i, f\"{val*100:.1f}\",\n",
    "            ha=\"center\", va=\"center\",\n",
    "            color=\"white\" if val >= 0.5 else \"black\",\n",
    "            fontsize=5\n",
    "        )\n",
    "\n",
    "# 外枠だけ表示\n",
    "for spine in ax.spines.values():\n",
    "    spine.set_visible(True)\n",
    "    spine.set_linewidth(0.8)\n",
    "    spine.set_color(\"black\")\n",
    "\n",
    "fig.subplots_adjust(\n",
    "    left=0.28,\n",
    "    right=0.98,\n",
    "    top=0.78,\n",
    "    bottom=0.05\n",
    ")\n",
    "\n",
    "\n",
    "fig.savefig(OUT_PDF, bbox_inches=\"tight\")\n",
    "\n",
    "plt.show()\n",
    "plt.close()"
   ]
  }
 ],
