# OS/editor files
# macOS が自動生成するフォルダ情報ファイル
.DS_Store
# Windows が作るサムネイル管理ファイル
Thumbs.db
# VSCode の設定フォルダ
.vscode/

# Python environments and caches
# Python 仮想環境のフォルダ
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
# pytest のキャッシュフォルダ
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
# Jupyter Notebook の自動保存フォルダ
.ipynb_checkpoints/

# Brian2/Cython/generated runtime artifacts
# Brian2/Cython 実行時のキャッシュ
**/brian2_cython_cache/
# 実行時に生成されるキャッシュ
**/_runtime_cache/
# Windows 用の Python 拡張モジュール
*.pyd
# コンパイル時に生成されるオブジェクトファイル
*.obj
# Windows のライブラリファイル
*.lib
# Windows のエクスポートファイル
*.exp
# C++ のソースコードファイル
*.cpp
# Cython のソースコードファイル
*.pyx
# 実行ログ・エラーログなど
*.log

# NumPy 配列を保存する単体ファイル
*.npy
# NumPy 配列を保存する圧縮ファイル
*.npz

# Tactile data
tactile_data/

*.gitignore
*.gitattributes
auto_git_push.ps1
git_log/

