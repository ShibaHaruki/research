# Keep source files stable across Windows/macOS/Linux.
* text=auto

*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ipynb text eol=lf
*.gitignore text eol=lf
.gitattributes text eol=lf

# Binary/data artifacts
*.npy binary
*.npz binary
*.xlsx binary
*.pdf binary
*.png binary
*.gif binary
*.pyd binary
